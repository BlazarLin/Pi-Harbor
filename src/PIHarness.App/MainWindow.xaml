<!-- Created: 2026-09-06; Purpose: Present the Codex-inspired project tree and pi chat workspace. -->
<Window x:Class="PIHarness.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PIHarness.App.ViewModels"
        xmlns:p="clr-namespace:PIHarness.App.Presentation"
        mc:Ignorable="d"
        Title="PI-Harness"
        Width="1280" Height="820"
        MinWidth="960" MinHeight="640"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="14"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Window.Resources>
        <p:ChatMessageTemplateSelector x:Key="MessageTemplateSelector" />

        <DataTemplate x:Key="UserMessageTemplate">
            <Grid Margin="70,8,18,8">
                <Border MaxWidth="760" HorizontalAlignment="Right"
                        Background="{StaticResource UserBubbleBrush}"
                        CornerRadius="9" Padding="14,10">
                    <p:MarkdownTextBlock Markdown="{Binding Text}" IsStreaming="{Binding IsStreaming}"
                                         Foreground="{StaticResource PrimaryTextBrush}"
                                         FontSize="14" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AssistantMessageTemplate">
            <Grid Margin="18,8,70,8">
                <p:MarkdownTextBlock MaxWidth="880" HorizontalAlignment="Left"
                                     Markdown="{Binding Text}" IsStreaming="{Binding IsStreaming}"
                                     Foreground="{StaticResource PrimaryTextBrush}"
                                     FontSize="14" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ThinkingMessageTemplate">
            <Expander Margin="18,4,70,4" Foreground="{StaticResource SecondaryTextBrush}"
                      Header="思考过程" IsExpanded="False">
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,0"
                        Margin="0,6,0,0" Padding="10,4">
                    <p:MarkdownTextBlock Markdown="{Binding Text}" IsStreaming="{Binding IsStreaming}"
                                         Foreground="{StaticResource SecondaryTextBrush}"
                                         FontSize="13" />
                </Border>
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="ToolMessageTemplate">
            <Expander Margin="18,4,70,4" Foreground="{StaticResource SecondaryTextBrush}"
                      Header="{Binding Title}" IsExpanded="False">
                <Border Background="{StaticResource PanelBrush}" CornerRadius="6"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Margin="0,6,0,0" Padding="10,7">
                    <p:MarkdownTextBlock Markdown="{Binding Text}" IsStreaming="{Binding IsStreaming}"
                                         Foreground="{StaticResource SecondaryTextBrush}"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                </Border>
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="SystemMessageTemplate">
            <Border Margin="18,5,70,5" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="10,7">
                <p:MarkdownTextBlock Markdown="{Binding Text}" IsStreaming="{Binding IsStreaming}"
                                     Foreground="{StaticResource SecondaryTextBrush}"
                                     FontSize="13" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ErrorMessageTemplate">
            <Border Margin="18,6,70,6" Background="#392525" CornerRadius="6" Padding="11,8">
                <TextBlock Text="{Binding Text}" Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap" />
            </Border>
        </DataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:ProjectGroupViewModel}" ItemsSource="{Binding Sessions}">
            <Grid ToolTip="{Binding Cwd}" Margin="0,5,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="▱" FontSize="17" Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource PrimaryTextBrush}" />
            </Grid>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type vm:SessionItemViewModel}">
            <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" Margin="2,4,4,4"
                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource PrimaryTextBrush}" />
        </DataTemplate>

        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="HeaderBorder" CornerRadius="6" Padding="4,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent" BorderThickness="0" Focusable="False">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <TextBlock x:Name="Arrow" Text="›" FontSize="17"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Arrow" Property="Text" Value="⌄" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" />
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="18,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource SelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="240" MaxWidth="420" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12,12,12,7">
                    <TextBlock Text="PI-Harness" FontSize="17" FontWeight="SemiBold" Margin="6,2,0,12" />
                    <Button Style="{StaticResource FlatButtonStyle}" Click="OnNewSessionClick" IsEnabled="{Binding CanSwitchSession}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="＋" FontSize="18" Width="27" />
                            <TextBlock Text="新对话" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButtonStyle}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻" FontSize="17" Width="27" />
                            <TextBlock Text="刷新会话" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="项目" Foreground="{StaticResource MutedTextBrush}"
                               FontWeight="SemiBold" Margin="6,18,0,7" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                        <TextBlock Text="{Binding ModelText}" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <TreeView x:Name="SessionTree" ItemsSource="{Binding Projects}"
                          IsHitTestVisible="{Binding CanSwitchSession}"
                          SelectedItemChanged="OnSessionSelected"
                          Background="Transparent" BorderThickness="0"
                          Padding="8,0,8,8" Foreground="{StaticResource PrimaryTextBrush}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling" />
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext" />

        <Grid Grid.Column="2" Background="{StaticResource WindowBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CurrentCwd}" Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentCwd}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <TextBlock Text="选择左侧会话，或新建一个对话"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="15">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ListBox x:Name="MessageList" ItemsSource="{Binding Messages}"
                         ItemTemplateSelector="{StaticResource MessageTemplateSelector}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         SelectionMode="Single" ScrollViewer.ScrollChanged="OnMessageScrollChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>

            <Border Grid.Row="2" Margin="18,10,18,18" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PromptBox" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="170"
                             VerticalScrollBarVisibility="Auto" Background="Transparent"
                             Foreground="{StaticResource PrimaryTextBrush}" BorderThickness="0"
                             Padding="3,5" FontSize="14">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SendCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="停止" Command="{Binding StopCommand}"
                            Style="{StaticResource FlatButtonStyle}" Margin="6,1" VerticalAlignment="Bottom" />
                    <Button Grid.Column="2" Content="发送" Command="{Binding SendCommand}"
                            Style="{StaticResource FlatButtonStyle}" Background="{StaticResource AccentBrush}"
                            Margin="3,1" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
