<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK projection is required for Windows.UI toast notifications. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Pi-Harbor</AssemblyName>
    <RootNamespace>PIHarness.App</RootNamespace>
    <AssemblyTitle>Pi Harbor — Pi Session Desk</AssemblyTitle>
    <Product>Pi Harbor</Product>
    <Description>Pi Session Desk - 集中停靠、浏览并继续本机 Pi 会话的桌面港湾</Description>
    <Version>1.5.0</Version>
    <AssemblyVersion>1.5.0.0</AssemblyVersion>
    <FileVersion>1.5.0.0</FileVersion>
    <InformationalVersion>1.5.0</InformationalVersion>
    <ApplicationIcon>Assets\Pi-Harbor.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\Pi-Harbor.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>
  <!-- The toolkit declares System.Drawing.Common 4.7.0, but the .NET SDK prunes it to the patched
       Windows Desktop runtime version; suppress the stale advisory for the declared minimum. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rxg9-xrhp-64gj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PIHarness.Core\PIHarness.Core.csproj" />
  </ItemGroup>
</Project>
