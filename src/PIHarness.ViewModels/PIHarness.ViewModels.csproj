<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Platform-neutral presentation state shared by the WPF and Avalonia frontends. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- Keep ApplicationVersion (read from this assembly) in lockstep with the frontends. -->
    <Version>1.9.0</Version>
    <AssemblyVersion>1.9.0.0</AssemblyVersion>
    <FileVersion>1.9.0.0</FileVersion>
    <AssemblyName>PIHarness.ViewModels</AssemblyName>
    <RootNamespace>PIHarness.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PIHarness.Tests" />
    <InternalsVisibleTo Include="Pi-Harbor" />
    <InternalsVisibleTo Include="PIHarness.Avalonia" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PIHarness.Core\PIHarness.Core.csproj" />
  </ItemGroup>
</Project>
