<Application x:Class="PIHarness.Avalonia.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
             xmlns:p="clr-namespace:PIHarness.Avalonia.Presentation"
             xmlns:sys="using:System"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button.flat">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Root" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.flat:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="Button.flat:pressed /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
        </Style>
        <Style Selector="Button.flat:disabled">
            <Setter Property="Opacity" Value="0.42" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="AccentRoot" Background="{TemplateBinding Background}" CornerRadius="16"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ Border#AccentRoot">
            <Setter Property="Background" Value="#9087F2" />
        </Style>
        <Style Selector="Button.accent:pressed /template/ Border#AccentRoot">
            <Setter Property="Background" Value="#665BCB" />
        </Style>
        <Style Selector="Button.accent:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="TextBox.harbor">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <!-- Composer input: borderless like the WPF PromptBox (sits directly on the panel). -->
        <Style Selector="TextBox.composer">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Style.Resources>
                <SolidColorBrush x:Key="TextControlBackground">Transparent</SolidColorBrush>
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver">Transparent</SolidColorBrush>
                <SolidColorBrush x:Key="TextControlBackgroundFocused">Transparent</SolidColorBrush>
                <SolidColorBrush x:Key="TextControlBackgroundDisabled">Transparent</SolidColorBrush>
                <SolidColorBrush x:Key="TextControlBorderBrush">Transparent</SolidColorBrush>
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver">Transparent</SolidColorBrush>
                <SolidColorBrush x:Key="TextControlBorderBrushFocused">Transparent</SolidColorBrush>
                <SolidColorBrush x:Key="TextControlBorderBrushDisabled">Transparent</SolidColorBrush>
                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                <Thickness x:Key="TextControlBorderThemeThicknessPointerOver">0</Thickness>
                <Thickness x:Key="TextControlBorderThemeThicknessDisabled">0</Thickness>
                <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#777272" />
                <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#777272" />
                <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#777272" />
            </Style.Resources>
        </Style>

    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <!-- Pi Harbor dark palette (mirrors Themes/Colors.xaml). -->
            <SolidColorBrush x:Key="WindowBrush" Color="#171717" />
            <SolidColorBrush x:Key="SidebarBrush" Color="#1D1C1C" />
            <SolidColorBrush x:Key="PanelBrush" Color="#232222" />
            <SolidColorBrush x:Key="HoverBrush" Color="#2B2A2A" />
            <SolidColorBrush x:Key="SelectedBrush" Color="#343232" />
            <SolidColorBrush x:Key="CurrentSessionBrush" Color="#454064" />
            <SolidColorBrush x:Key="BorderBrush" Color="#383636" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1EEEE" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A8A3A3" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#777272" />
            <SolidColorBrush x:Key="AccentBrush" Color="#7D73EA" />
            <SolidColorBrush x:Key="UserBubbleBrush" Color="#37334F" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#F18B8B" />
            <SolidColorBrush x:Key="StarBrush" Color="#E8B93E" />
            <SolidColorBrush x:Key="UnreadBrush" Color="#7D73EA" />
            <SolidColorBrush x:Key="HighlightBrush" Color="#4A4470" />

            <ControlTheme x:Key="ExpanderToggle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter>
            </ControlTheme>
            <!-- ==== FluentTheme palette overrides: align framework controls with the Pi Harbor dark palette. ==== -->
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#232222" />
            <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#232222" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#2B2A2A" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#343232" />
            <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#232222" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="#383636" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#7D73EA" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#383636" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#4A4763" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#7D73EA" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#383636" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#F1EEEE" />
            <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#777272" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#F1EEEE" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="#F1EEEE" />
            <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#777272" />
            <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" Color="#777272" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#232222" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#383636" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#A8A3A3" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="#A8A3A3" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="#A8A3A3" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="#777272" />
            <sys:Double x:Key="ComboBoxMinHeight">34</sys:Double>
            <SolidColorBrush x:Key="ComboBoxItemBackground" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#2B2A2A" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#343232" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#454064" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#4A4470" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#37334F" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundDisabled" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#F1EEEE" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#F1EEEE" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundDisabled" Color="#777272" />
            <SolidColorBrush x:Key="ComboBoxItemBorderBrush" Color="#00FFFFFF" />

            <SolidColorBrush x:Key="ScrollBarBackground" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="ScrollBarTrackBorderBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="ScrollBarThumbBackgroundColor" Color="#575454" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#716D6D" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#716D6D" />
            <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="#383636" />
            <SolidColorBrush x:Key="ScrollBarButtonBackground" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="ScrollBarButtonBackgroundPointerOver" Color="#2B2A2A" />
            <SolidColorBrush x:Key="ScrollBarButtonBackgroundPressed" Color="#343232" />
            <SolidColorBrush x:Key="ScrollBarButtonBackgroundDisabled" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="ScrollBarButtonBorderBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="ScrollBarButtonBorderBrushPointerOver" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="ScrollBarButtonBorderBrushPressed" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="ScrollBarButtonBorderBrushDisabled" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="#777272" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPointerOver" Color="#A8A3A3" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPressed" Color="#F1EEEE" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundDisabled" Color="#383636" />
            <SolidColorBrush x:Key="ScrollBarForeground" Color="#F1EEEE" />
            <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#575454" />
            <sys:Double x:Key="ScrollBarSize">10</sys:Double>
            <Thickness x:Key="ComboBoxBorderThemeThickness">1</Thickness>

            <SolidColorBrush x:Key="ToolTipBackground" Color="#303030" />
            <SolidColorBrush x:Key="ToolTipForeground" Color="#F1EEEE" />
            <!-- ==== end overrides ==== -->

            <p:StringNotEmptyToBoolConverter x:Key="StringNotEmptyToBool" />
            <p:BytesToBitmapConverter x:Key="BytesToBitmap" />
            <p:InverseBoolConverter x:Key="InverseBool" />
            <p:MessageTemplateSelector x:Key="MessageTemplateSelector" />
            <p:SidebarTemplateSelector x:Key="SidebarTemplateSelector" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
