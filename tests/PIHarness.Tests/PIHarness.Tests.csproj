<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows 构建保留 WPF 契约测试；Linux/macOS 构建只编译跨平台 Core/ViewModel 测试。 -->
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net10.0-windows10.0.17763.0</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFramework>
    <AssemblyName>PIHarness.Tests</AssemblyName>
    <RootNamespace>PIHarness.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PIHarness.Core\PIHarness.Core.csproj" />
    <ProjectReference Include="..\..\src\PIHarness.ViewModels\PIHarness.ViewModels.csproj" />
  </ItemGroup>
  <!-- 依赖 WPF 文档对象与 Application 的用例只在 Windows 编译。 -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <ProjectReference Include="..\..\src\PIHarness.App\PIHarness.App.csproj" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rxg9-xrhp-64gj" />
  </ItemGroup>
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <Compile Remove="MarkdownRenderingPolicyTests.cs" />
  </ItemGroup>
</Project>
